# Copy to .env and fill in.
#
# Three connection strings, and they are NOT interchangeable:
#   DATABASE_URL              the app at runtime. Use the POOLED host (…-pooler…).
#   POSTGRES_URL_NON_POOLING  read by prisma.config.ts, so every Prisma CLI command.
#   DATABASE_URL_UNPOOLED     read by the backup and restore scripts.
# The last two want the DIRECT (non-pooled) host: the pooler can drop a session
# mid-DDL or mid-copy. Change all three together. Setting only DATABASE_URL
# leaves `prisma db push` and every backup aimed at whatever the others name,
# which is how a schema push lands on the wrong database.
#
# Keep sslmode=verify-full. pg treats sslmode=require as an alias for
# verify-full today, but pg 9 and pg-connection-string 3 will move it to libpq
# semantics, which skip certificate and hostname verification. Spelling out the
# strong mode means that upgrade cannot silently downgrade TLS. Quote the whole
# value: these strings contain & and an unquoted one breaks `source .env`.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=verify-full"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/dbname?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=verify-full"

# Optional: enables the "IEEE Xplore API" source in Admin > Catalogue >
# LiveFetch import. Register at https://developer.ieee.org. Without it the
# Crossref-backed IEEE source still works (no key needed).
IEEE_API_KEY=""

# Optional: enables the AI cataloguing assistant (Admin > Catalogue >
# LiveFetch > Manual entry > "Draft with AI") for URL and free-text drafting.
# DOIs work without it (resolved via Crossref). Create a key at
# https://platform.claude.com (uses model claude-opus-5).
ANTHROPIC_API_KEY=""

# Scheduled metadata import (Admin > Batch Processes > SFTP). All optional:
# leave unset and the job stays inert ("Not configured"). Credentials live
# here / in the Vercel project env only, never in the database or code.
CRON_SECRET=""              # required to arm the cron endpoint; Vercel sends it as a Bearer token
SFTP_HOST=""                # vendor SFTP host, e.g. sftp.janes.com
SFTP_PORT="22"
SFTP_USER=""
SFTP_PASSWORD=""            # use either a password…
SFTP_PRIVATE_KEY=""         # …or a PEM private key (\n-escaped is fine)
SFTP_PASSPHRASE=""          # optional, if the key is encrypted
SFTP_REMOTE_DIR="."         # directory to poll for batch files
SFTP_PROVIDER="Janes"       # provider tag applied to imported resources
SFTP_DEFAULT_TYPE="EBOOK"   # resource type for rows without one (BOOK/EBOOK/JOURNAL/…)

# Optional: encrypts backups at source (AES-256-GCM). Without it `npm run backup`
# writes plain gzip holding member names and email addresses. Set it for any dump
# that will leave this machine, and store the key somewhere the backups are not.
BACKUP_KEY=""

# Optional: needed only by `npm run neon:retention` and `npm run neon:move`, to
# read or change the database's recovery window. Must belong to the Neon account
# that owns the project; run `npm run neon:retention` with no key to be told
# which project id that is. The Vercel/Neon integration does not expose one.
NEON_API_KEY=""

# Optional: set only when restoring. Deliberately separate from DATABASE_URL,
# because a restore replaces data and defaulting to the app's own database is how
# a drill becomes an outage.
RESTORE_URL=""

# Outbound mail (Admin > Batch Processes > Mail outbox). Notices are always
# written to the outbox; these decide whether anything leaves it. Unset means
# nothing is sent, which is the intended state until KLSI names a provider.
#
# Preview deployments never send, whatever these say. That is not configurable:
# a branch nobody has reviewed must not be able to email a library member.
MAIL_ENABLED=""             # "1" to send. Opt in, so a new environment starts silent.
MAIL_API_KEY=""             # provider key. Without it, and MAIL_FROM, the transport is a no-op.
MAIL_FROM=""                # verified sender, e.g. "KLSI Library <library@klsi.edu.sg>"
MAIL_API_BASE=""            # defaults to https://api.resend.com; set to point at another provider
MAIL_ALLOWLIST=""           # comma-separated addresses or @domains. Set on any non-production
                            # environment: anything not matching is suppressed, not sent.
MAIL_BATCH_SIZE="25"        # messages attempted per drain (max 200)
MAIL_MAX_AGE_HOURS="72"     # a queued notice older than this expires instead of sending late

# Link-out proxy (Portal API). When set, access links on subscription
# resources are wrapped so a learner arrives at licensed full text through the
# library's authenticating proxy instead of hitting the paywall. Unset, links
# serve unmodified. The stored URLs stay canonical either way; wrapping
# happens at serve time only, so the nightly link check still tests the real
# destination. Ask KLSI for their proxy's URL pattern.
#   Append form:      PROXY_PREFIX="https://proxy.example.sg/login?url="
#   Placeholder form: PROXY_PREFIX="https://proxy.example.sg/go?u={url}"
PROXY_PREFIX=""
# Hosts never wrapped (open-access destinations a strict proxy refuses).
# Comma-separated; a leading dot matches subdomains, e.g. ".arxiv.org".
PROXY_BYPASS_HOSTS=""
