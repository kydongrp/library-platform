// Library Platform — data model for the core loop MVP.
// SQLite has no native enums, so status/type fields are strings with the
// allowed values documented inline next to each field.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A bibliographic record in the catalogue (the "title").
model Resource {
  id            String        @id @default(cuid())
  title         String
  subtitle      String?
  author        String
  isbn          String?
  type          String // BOOK, EBOOK, AUDIOBOOK, JOURNAL, DVD
  category      String // Area of Interest: Technology, Business, Science, Arts, Fiction, History, Health
  publisher     String?
  publishedYear Int?
  language      String        @default("English")
  description   String?
  coverColor    String        @default("#4F46E5") // used to render a placeholder cover
  digital       Boolean       @default(false) // digital titles grant instant access, no physical copy
  digitalUrl    String? // direct access link (e.g. an IEEE Xplore article URL)
  provider      String? // external subscription source, e.g. "IEEE Xplore". Null = local collection.
  licenseSeats  Int? // concurrent-user limit for digital titles; null = unlimited (contract FR 8.2)
  editorsPick   Boolean       @default(false) // staff-curated highlight (live system: "editorspick" rail)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  copies        Copy[]
  loans         Loan[]
  reservations  Reservation[]
  reviews       Review[]
  favouritedIn  FavouriteItem[]
  browsedBy     BrowsingHistory[]
}

/// A physical (or digital seat) holding of a Resource that can be loaned out.
model Copy {
  id         String   @id @default(cuid())
  barcode    String   @unique
  status     String   @default("AVAILABLE") // AVAILABLE, ON_LOAN, RESERVED, LOST, MAINTENANCE
  location   String   @default("Main Shelf")
  createdAt  DateTime @default(now())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  loans      Loan[]
}

/// A library patron who can borrow and reserve resources.
model Member {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  memberType   String        @default("STUDENT") // STAFF, STUDENT, EXTERNAL
  status       String        @default("ACTIVE") // ACTIVE, SUSPENDED
  maxLoans     Int           @default(5)
  joinedAt     DateTime      @default(now())
  tcAcceptedAt DateTime? // digital-resource terms & conditions acceptance (contract FR 8.1)
  interests    String[] @default([]) // Areas of Interest (categories) driving recommendations
  loans        Loan[]
  reservations Reservation[]
  notifications Notification[]
  requests     ResourceRequest[]
  reviews      Review[]
  folders      FavouriteFolder[]
  browsing     BrowsingHistory[]
  searches     SearchHistory[]
}

/// A member-named collection of favourite titles (live system: bookmark
/// folders; SDD: My Favourites organised in folders).
model FavouriteFolder {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items     FavouriteItem[]

  @@unique([memberId, name])
}

model FavouriteItem {
  id         String          @id @default(cuid())
  addedAt    DateTime        @default(now())
  folderId   String
  folder     FavouriteFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([folderId, resourceId])
}

/// Titles a member has opened (SDD: My Browsing History). One row per
/// member+resource, re-viewing bumps viewedAt.
model BrowsingHistory {
  id         String   @id @default(cuid())
  viewedAt   DateTime @default(now())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([memberId, resourceId])
}

/// Search terms a member has run — feeds "based on past searches".
model SearchHistory {
  id         String   @id @default(cuid())
  query      String
  searchedAt DateTime @default(now())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// A member's star rating + optional text for a resource (live-system
/// /Loans/review; contract FR 8.1 ratings/reviews). One review per member
/// per resource, editable and deletable by its author.
model Review {
  id         String   @id @default(cuid())
  rating     Int // 1..5
  text       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([resourceId, memberId])
}

/// A single borrowing transaction. Physical loans reference a Copy; digital
/// loans reference only the Resource (copyId is null).
model Loan {
  id         String    @id @default(cuid())
  borrowedAt DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  status     String    @default("ACTIVE") // ACTIVE, RETURNED
  renewals   Int       @default(0)
  recalledAt DateTime? // staff recall (contract FR 8.2) — due date shortened, member notified
  copyId     String?
  copy       Copy?     @relation(fields: [copyId], references: [id])
  resourceId String
  resource   Resource  @relation(fields: [resourceId], references: [id])
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id])
}

/// A hold placed on a Resource when no copy is currently available.
model Reservation {
  id         String    @id @default(cuid())
  reservedAt DateTime  @default(now())
  status     String    @default("PENDING") // PENDING, READY, FULFILLED, CANCELLED, EXPIRED
  readyAt    DateTime?
  resourceId String
  resource   Resource  @relation(fields: [resourceId], references: [id])
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id])
}

/// A staff account for the Admin Panel (SDD: AdminAccount). Authentication is
/// stubbed (act-as switcher); authorisation is enforced via the group matrix.
model AdminUser {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  status    String     @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime   @default(now())
  groupId   String
  group     AdminGroup @relation(fields: [groupId], references: [id])
}

/// A staff role (SDD: AdminGroups) holding per-area permissions.
model AdminGroup {
  id          String                @id @default(cuid())
  name        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  users       AdminUser[]
  permissions AdminGroupPermission[]
}

/// One row per (group, area) — the user access matrix (SDD: AdminGroupArea).
model AdminGroupPermission {
  id      String     @id @default(cuid())
  area    String // DASHBOARD, CIRCULATION, CATALOGUE, MEMBERS, LOANS, RESERVATIONS, POLICIES, TEMPLATES, REPORTS, BATCH, ADMIN
  canView Boolean    @default(false)
  canEdit Boolean    @default(false)
  groupId String
  group   AdminGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, area])
}

/// Configurable circulation rules (SDD: LoansPolicies). One row per member
/// type; the DEFAULT row backstops anything unmatched.
model LoanPolicy {
  id            String   @id @default(cuid())
  memberType    String   @unique // STUDENT, STAFF, EXTERNAL, DEFAULT
  loanDays      Int      @default(14)
  maxLoans      Int      @default(5)
  maxRenewals   Int      @default(2)
  renewalDays   Int      @default(14)
  digitalDays   Int      @default(14)
  holdPickupDays Int     @default(3) // READY reservations expire after this many days
  updatedAt     DateTime @updatedAt
}

/// Editable notification templates (SDD: SystemEmailTemplates). Placeholders
/// like {{memberName}}, {{resourceTitle}}, {{dueDate}} are substituted at send.
model EmailTemplate {
  id           String   @id @default(cuid())
  code         String   @unique // PREDUE, OVERDUE, WELCOME, INACTIVE, RESERVATION_READY, RESERVATION_CANCELLED, BORROW, RETURN
  name         String
  subject      String
  body         String
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

/// In-app notification for a member (SDD: Notification Centre feed).
model Notification {
  id        String    @id @default(cuid())
  type      String // template code
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Outbound email queue (SDD: MailQ). No SMTP in the prototype — rows are
/// visible in the admin outbox as proof of the notification flow.
model MailQueue {
  id        String   @id @default(cuid())
  toEmail   String
  toName    String
  subject   String
  body      String
  template  String
  status    String   @default("QUEUED") // QUEUED, SENT (simulated)
  createdAt DateTime @default(now())
}

/// One row per EodProcess execution, with a summary of what was generated.
model BatchRun {
  id         String   @id @default(cuid())
  process    String   @default("EOD")
  summary    String
  ranAt      DateTime @default(now())
  ranBy      String?
}

/// A learner's request for a resource the library doesn't hold (contract FR
/// 8.1 "Information Resource Requests" — built natively instead of the
/// permitted FormSG placeholder).
model ResourceRequest {
  id        String   @id @default(cuid())
  title     String
  author    String?
  details   String? // why it's needed, edition, URL, etc.
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED, ACQUIRED
  staffNote String?
  decidedBy String? // admin name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Result of the most recent broken-link scan for a resource's access URL
/// (contract FR 8.2 "broken-link detection and administrator alerting").
model LinkCheck {
  id         String   @id @default(cuid())
  resourceId String   @unique
  url        String
  ok         Boolean
  statusCode Int?
  error      String?
  checkedAt  DateTime @default(now())
}

/// A batch metadata file already ingested by the scheduled import service
/// (SDD: Metadata Import Service — vendor XML dropped via SFTP). Gives the
/// re-fetch job idempotency: a filename is imported once per source.
model ImportedFile {
  id                String   @id @default(cuid())
  source            String // e.g. "sftp"
  filename          String
  resourcesImported Int      @default(0)
  status            String   @default("OK") // OK, PARSE_ERROR
  detail            String?
  fetchedAt         DateTime @default(now())

  @@unique([source, filename])
}
