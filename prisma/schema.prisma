// Library Platform — data model for the core loop MVP.
// SQLite has no native enums, so status/type fields are strings with the
// allowed values documented inline next to each field.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A bibliographic record in the catalogue (the "title").
model Resource {
  id            String        @id @default(cuid())
  title         String
  subtitle      String?
  author        String
  isbn          String?
  type          String // BOOK, EBOOK, AUDIOBOOK, JOURNAL, DVD
  /// Bib-level material designation, as the Vibrante ILS tags every record:
  /// MONOGRAPH (standalone work) or SERIAL (journal/magazine/newspaper).
  /// Drives MARC leader/07, catalogue filtering, and serials eligibility.
  materialDesignation String @default("MONOGRAPH")
  category      String // Area of Interest: Technology, Business, Science, Arts, Fiction, History, Health
  publisher     String?
  publishedYear Int?
  language      String        @default("English")
  description   String?
  coverColor    String        @default("#4F46E5") // used to render a placeholder cover
  digital       Boolean       @default(false) // digital titles grant instant access, no physical copy
  digitalUrl    String?       @unique // direct access link; unique so concurrent imports can't double-insert the same link-out (NULLs are exempt)
  provider      String? // external subscription source, e.g. "IEEE Xplore". Null = local collection.
  licenseSeats  Int? // concurrent-user limit for digital titles; null = unlimited (contract FR 8.2)
  editorsPick   Boolean       @default(false) // staff-curated highlight (live system: "editorspick" rail)
  epExternal    Boolean       @default(false) // pick exists ONLY as an Editor's Pick (promoted from outside the collection) — removing it from the picks deletes it from the library (BR-366G); internal picks stay in the catalogue (BR-366I)
  epBlurb       String? // curator's note shown with the pick
  epPickedAt    DateTime?
  epPickedBy    String? // staff name — feeds contribution tracking later
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  copies        Copy[]
  loans         Loan[]
  reservations  Reservation[]
  reviews       Review[]
  favouritedIn  FavouriteItem[]
  browsedBy     BrowsingHistory[]
  epSubmissions EpSubmission[]
  epSuggestionDismissal EpSuggestionDismissal?
  serial        Serial?
}

/// A physical (or digital seat) holding of a Resource that can be loaned out.
model Copy {
  id         String   @id @default(cuid())
  barcode    String   @unique
  status     String   @default("AVAILABLE") // AVAILABLE, ON_LOAN, RESERVED, LOST, MAINTENANCE — circulation state, system-controlled
  location   String   @default("Main Shelf") // legacy free-text shelf; superseded by locationId when set
  createdAt  DateTime @default(now())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  loans      Loan[]

  // Item-level cataloguing (Vibrant "Items" module). All optional so existing
  // copies stay valid; the code lists are what staff actually manage.
  collectionId String?
  collection   ItemCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  locationId   String?
  itemLocation ItemLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  itemTypeId   String?
  itemType     ItemType?       @relation(fields: [itemTypeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([collectionId])
  @@index([locationId])
}

/// A collection code grouping items (Reference, Reserve, General…). May cap
/// how many items from it a member can hold at once.
model ItemCollection {
  id                String  @id @default(cuid())
  code              String  @unique
  name              String
  loanLimitOverride Int? // overrides the policy's maxLoans for items in this collection
  notes             String?
  createdAt         DateTime @default(now())
  copies            Copy[]
}

/// Where a copy physically lives.
model ItemLocation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  notes     String?
  createdAt DateTime @default(now())
  copies    Copy[]
}

/// Item-level resource type. Combined with member type this forms the loan
/// policy matrix (the real DLS rule is user-type x item-type).
model ItemType {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  loanable  Boolean      @default(true) // false = reference-only, never issued
  createdAt DateTime     @default(now())
  copies    Copy[]
  policies  LoanPolicy[]
}

/// Append-only record of weeded/deleted copies (Vibrant: Items Weed Log).
model ItemWeedLog {
  id         String   @id @default(cuid())
  barcode    String
  title      String
  reason     String
  collection String?
  location   String?
  weededBy   String
  weededAt   DateTime @default(now())
}

/// A configurable member status (beyond the built-in Active/Suspended).
/// canBorrow drives the circulation gate; exactly one status is the default
/// for new and imported members.
model MemberStatus {
  id        String   @id @default(cuid())
  name      String   @unique // display name, e.g. "Active", "Alumni", "On exchange"
  canBorrow Boolean  @default(true)
  isDefault Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

/// A library patron who can borrow and reserve resources.
model Member {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  memberType   String        @default("STUDENT") // STAFF, STUDENT, EXTERNAL
  status       String        @default("Active") // references MemberStatus.name
  phone        String?
  language     String        @default("English") // notice/preference language
  location     String? // campus / site / branch
  department   String?
  maxLoans     Int           @default(5)
  joinedAt     DateTime      @default(now())
  tcAcceptedAt DateTime? // digital-resource terms & conditions acceptance (contract FR 8.1)
  interests    String[] @default([]) // Areas of Interest (categories) driving recommendations
  loans        Loan[]
  reservations Reservation[]
  notifications Notification[]
  requests     ResourceRequest[]
  reviews      Review[]
  folders      FavouriteFolder[]
  browsing     BrowsingHistory[]
  searches     SearchHistory[]
}

/// A member-named collection of favourite titles (live system: bookmark
/// folders; SDD: My Favourites organised in folders).
model FavouriteFolder {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items     FavouriteItem[]

  @@unique([memberId, name])
}

model FavouriteItem {
  id         String          @id @default(cuid())
  addedAt    DateTime        @default(now())
  folderId   String
  folder     FavouriteFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([folderId, resourceId])
}

/// Titles a member has opened (SDD: My Browsing History). One row per
/// member+resource, re-viewing bumps viewedAt.
model BrowsingHistory {
  id         String   @id @default(cuid())
  viewedAt   DateTime @default(now())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([memberId, resourceId])
}

/// Search terms a member has run — feeds "based on past searches".
model SearchHistory {
  id         String   @id @default(cuid())
  query      String
  searchedAt DateTime @default(now())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// A member's star rating + optional text for a resource (live-system
/// /Loans/review; contract FR 8.1 ratings/reviews). One review per member
/// per resource, editable and deletable by its author.
model Review {
  id         String   @id @default(cuid())
  rating     Int // 1..5
  text       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([resourceId, memberId])
}

/// A single borrowing transaction. Physical loans reference a Copy; digital
/// loans reference only the Resource (copyId is null).
model Loan {
  id         String    @id @default(cuid())
  borrowedAt DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  status     String    @default("ACTIVE") // ACTIVE, RETURNED
  renewals   Int       @default(0)
  recalledAt DateTime? // staff recall (contract FR 8.2) — due date shortened, member notified

  // Return tracking: both axes are recorded at check-in so loan history can
  // be filtered on either. Timeliness is frozen at return (an ACTIVE loan's
  // overdue state is computed live instead).
  returnStatus    String? // ON_TIME, LATE
  returnCondition String? // GOOD, DAMAGED, LOST
  returnedBy      String? // staff member who checked it in

  // Fines: accrue live while overdue, assessed onto the loan at check-in.
  fineCents    Int       @default(0)
  finePaidAt   DateTime?
  fineWaivedAt DateTime?
  fineNote     String?

  copyId     String?
  copy       Copy?     @relation(fields: [copyId], references: [id])
  resourceId String
  resource   Resource  @relation(fields: [resourceId], references: [id])
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id])

  @@index([status, dueAt])
  @@index([returnedAt])
}

/// A hold placed on a Resource when no copy is currently available.
model Reservation {
  id         String    @id @default(cuid())
  reservedAt DateTime  @default(now())
  status     String    @default("PENDING") // PENDING, READY, FULFILLED, CANCELLED, EXPIRED
  readyAt    DateTime?
  resourceId String
  resource   Resource  @relation(fields: [resourceId], references: [id])
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id])
}

/// A staff account for the Admin Panel (SDD: AdminAccount). Authentication is
/// stubbed (act-as switcher); authorisation is enforced via the group matrix.
model AdminUser {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  status    String     @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime   @default(now())
  groupId   String
  group     AdminGroup @relation(fields: [groupId], references: [id])
}

/// A staff role (SDD: AdminGroups) holding per-area permissions.
model AdminGroup {
  id          String                @id @default(cuid())
  name        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  users       AdminUser[]
  permissions AdminGroupPermission[]
}

/// One row per (group, area) — the user access matrix (SDD: AdminGroupArea).
model AdminGroupPermission {
  id      String     @id @default(cuid())
  area    String // DASHBOARD, CIRCULATION, CATALOGUE, MEMBERS, LOANS, RESERVATIONS, POLICIES, TEMPLATES, REPORTS, BATCH, ADMIN
  canView Boolean    @default(false)
  canEdit Boolean    @default(false)
  groupId String
  group   AdminGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, area])
}

/// Configurable circulation rules (SDD: LoansPolicies). One row per member
/// type; the DEFAULT row backstops anything unmatched.
/// Circulation rules resolved on the member type x ITEM type matrix, as the
/// real DLS does. A null itemTypeId is the "any item type" row, so existing
/// per-member-type policies keep working untouched.
model LoanPolicy {
  id            String   @id @default(cuid())
  memberType    String // STUDENT, STAFF, EXTERNAL, DEFAULT
  itemTypeId    String? // null = applies to every item type
  itemType      ItemType? @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  loanDays      Int      @default(14)
  maxLoans      Int      @default(5)
  maxRenewals   Int      @default(2)
  renewalDays   Int      @default(14)
  digitalDays   Int      @default(14)
  holdPickupDays Int     @default(3) // READY reservations expire after this many days

  // Overdue charges. Fines accrue per OPEN day (library closures are not
  // chargeable) after the grace period, capped at maxFineCents.
  fineCentsPerDay Int  @default(0) // 0 = this member type is never fined
  fineGraceDays   Int  @default(0)
  maxFineCents    Int? // null = uncapped

  updatedAt     DateTime @updatedAt

  @@unique([memberType, itemTypeId])
}

/// A day the library is closed: due dates never land on one, fines do not
/// accrue on one, and hold pickup windows skip them.
model LibraryClosure {
  id        String   @id @default(cuid())
  date      DateTime @unique // date-only, stored at noon UTC
  name      String // "New Year's Day", "Stocktake"
  createdAt DateTime @default(now())
  createdBy String?
}

/// Single-row service calendar: which weekdays the library is routinely shut.
model ServiceCalendar {
  id            String   @id @default("singleton")
  closedWeekdays Int[]   @default([]) // 0 = Sunday … 6 = Saturday
  updatedAt     DateTime @updatedAt
}

/// Editable notification templates (SDD: SystemEmailTemplates). Placeholders
/// like {{memberName}}, {{resourceTitle}}, {{dueDate}} are substituted at send.
model EmailTemplate {
  id           String   @id @default(cuid())
  code         String   @unique // PREDUE, OVERDUE, WELCOME, INACTIVE, RESERVATION_READY, RESERVATION_CANCELLED, BORROW, RETURN
  name         String
  subject      String
  body         String
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

/// In-app notification for a member (SDD: Notification Centre feed).
model Notification {
  id        String    @id @default(cuid())
  type      String // template code
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Outbound email queue (SDD: MailQ). No SMTP in the prototype — rows are
/// visible in the admin outbox as proof of the notification flow.
model MailQueue {
  id        String   @id @default(cuid())
  toEmail   String
  toName    String
  subject   String
  body      String
  template  String
  status    String   @default("QUEUED") // QUEUED, SENT (simulated)
  createdAt DateTime @default(now())
}

/// One row per EodProcess execution, with a summary of what was generated.
model BatchRun {
  id         String   @id @default(cuid())
  process    String   @default("EOD")
  summary    String
  ranAt      DateTime @default(now())
  ranBy      String?
}

/// A learner's request for a resource the library doesn't hold (contract FR
/// 8.1 "Information Resource Requests" — built natively instead of the
/// permitted FormSG placeholder).
model ResourceRequest {
  id        String   @id @default(cuid())
  title     String
  author    String?
  details   String? // why it's needed, edition, URL, etc.
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED, ACQUIRED
  staffNote String?
  decidedBy String? // admin name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Result of the most recent broken-link scan for a resource's access URL
/// (contract FR 8.2 "broken-link detection and administrator alerting").
model LinkCheck {
  id         String   @id @default(cuid())
  resourceId String   @unique
  url        String
  ok         Boolean
  statusCode Int?
  error      String?
  checkedAt  DateTime @default(now())
}

/// A learner nomination for the Editor's Pick shelf (BR-366E/404). Learners
/// submit via the portal's form.sg flow (or send an external link over
/// WhatsApp); staff record the retrieved submissions here and approve or
/// reject them — approval promotes with one click instead of manual re-entry.
model EpSubmission {
  id         String    @id @default(cuid())
  kind       String // INTERNAL (nominates a catalogue title) | EXTERNAL (new outside link)
  channel    String    @default("FORMSG") // FORMSG, WHATSAPP, OTHER
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  submitter  String? // learner name/id as retrieved from the form
  reason     String? // why the learner thinks it should be featured
  resourceId String? // set for INTERNAL nominations
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  title      String? // EXTERNAL submissions carry their own metadata
  authors    String?
  url        String?
  provider   String?
  decidedBy  String?
  staffNote  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// A vendor the library orders from (SDD: acquisitions).
model Supplier {
  id        String          @id @default(cuid())
  name      String          @unique
  email     String?
  contact   String? // person / phone
  notes     String?
  status    String          @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]
  invoices  Invoice[]
}

/// A budget line for a fiscal year (SDD: acquisitions budgets). Committed and
/// spent are derived: open purchase orders commit, paid invoices spend.
model AcqFund {
  id          String          @id @default(cuid())
  fiscalYear  String // e.g. "FY2026"
  name        String // e.g. "Digital subscriptions", "Monographs"
  amountCents Int
  currency    String          @default("SGD")
  createdAt   DateTime        @default(now())
  orders      PurchaseOrder[]
  invoices    Invoice[]

  @@unique([fiscalYear, name])
}

/// A purchase order: commits fund money while ORDERED/RECEIVED, stops on
/// CANCELLED, and CLOSED once fully received and its invoice is paid.
model PurchaseOrder {
  id         String    @id @default(cuid())
  poNumber   String    @unique // PO-2026-0001
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  fundId     String
  fund       AcqFund   @relation(fields: [fundId], references: [id])
  status     String    @default("ORDERED") // ORDERED, RECEIVED, CLOSED, CANCELLED
  orderedAt  DateTime  @default(now())
  orderedBy  String
  notes      String?
  lines      PoLine[]
  invoices   Invoice[]
}

model PoLine {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  title       String
  qty         Int
  unitCents   Int
  receivedQty Int           @default(0)
}

/// A supplier invoice, charged to a fund; spends the budget once PAID.
model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  poId          String?
  po            PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  fundId        String
  fund          AcqFund        @relation(fields: [fundId], references: [id])
  amountCents   Int
  invoiceDate   DateTime
  status        String         @default("PENDING") // PENDING, PAID
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime       @default(now())

  @@unique([supplierId, invoiceNumber])
}

/// A journal/magazine subscription tracked at issue level (SDD: serials
/// management). The catalogue Resource is the bibliographic record; this row
/// carries the publication pattern and vendor claim contact.
model Serial {
  id         String        @id @default(cuid())
  resourceId String        @unique
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  issn       String?
  frequency  String // WEEKLY, BIWEEKLY, MONTHLY, BIMONTHLY, QUARTERLY, SEMIANNUAL, ANNUAL
  status     String        @default("ACTIVE") // ACTIVE, PAUSED, CLOSED
  claimEmail String? // vendor contact for missing-issue claims; admins alerted if unset
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  issues     SerialIssue[]
}

/// One predicted or received issue of a Serial. "Late" is computed
/// (EXPECTED and past expectedAt + grace); claimedAt records that a
/// missing-issue claim was queued.
model SerialIssue {
  id         String    @id @default(cuid())
  serialId   String
  serial     Serial    @relation(fields: [serialId], references: [id], onDelete: Cascade)
  seq        Int
  label      String // e.g. "No. 14 (Aug 2026)"
  expectedAt DateTime
  receivedAt DateTime?
  claimedAt  DateTime?
  status     String    @default("EXPECTED") // EXPECTED, RECEIVED, SKIPPED
  createdAt  DateTime  @default(now())

  @@unique([serialId, seq])
  @@index([status, expectedAt])
}

/// A credential for the read-only Portal API (/api/portal/v1). The full key
/// is shown once at creation; only its SHA-256 hash is stored.
model ApiClient {
  id         String    @id @default(cuid())
  name       String // e.g. "Learner Portal (prod)"
  keyPrefix  String    @unique // first characters of the key, for display + lookup
  keyHash    String    @unique // sha256 hex of the full key
  status     String    @default("ACTIVE") // ACTIVE, REVOKED
  createdBy  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // bumped at most once a minute
}

/// An outbound webhook the portal (or any consumer) registers to hear about
/// catalogue and Editor's Pick changes. Deliveries are HMAC-SHA256 signed
/// with `secret` (stored as entered — it is a shared signing secret).
model Webhook {
  id         String            @id @default(cuid())
  url        String
  secret     String
  events     String[] // subscribed event names; empty = all events
  status     String            @default("ACTIVE") // ACTIVE, DISABLED
  createdBy  String
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

/// One delivery attempt (newest kept per webhook, older rows pruned).
model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  ok         Boolean
  statusCode Int?
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([webhookId, createdAt])
}

/// A staff "no" to an auto-curation suggestion — dismissed titles are never
/// re-suggested (restorable from the same panel).
model EpSuggestionDismissal {
  id          String   @id @default(cuid())
  resourceId  String   @unique
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  dismissedBy String
  dismissedAt DateTime @default(now())
}

/// A provider subscription (e-resource licence): the registry behind the
/// E-Resources dashboard — renewal tracking and cost-per-use.
model Subscription {
  id              String    @id @default(cuid())
  provider        String    @unique // matches Resource.provider display values
  startDate       DateTime?
  renewalDate     DateTime
  autoRenews      Boolean   @default(false)
  annualCostCents Int? // in `currency` minor units; null = not recorded
  currency        String    @default("SGD")
  seats           Int? // licence-wide concurrent seats (per-title caps live on Resource.licenseSeats)
  notes           String? // key licence terms, account refs, cancellation window
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Monthly e-resource usage per provider — COUNTER R5.1 ingest or manual
/// entry. Drives the cost-per-use figures.
model UsageStat {
  id        String   @id @default(cuid())
  provider  String
  period    String // "YYYY-MM"
  metric    String   @default("Total_Item_Requests")
  count     Int
  source    String? // COUNTER filename, or "manual"
  createdAt DateTime @default(now())

  @@unique([provider, period, metric])
}

/// Append-only audit trail of every admin mutation (IM8: accountability).
/// Rows are only ever inserted — no update/delete path exists in the app.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actor    String // admin display name, or "cron" for scheduled jobs
  actorId  String? // AdminUser id when a session was present
  action   String // dot notation, e.g. "catalogue.update", "ep.approve"
  entity   String? // model touched, e.g. "Resource"
  entityId String?
  summary  String // human-readable one-liner
  detail   Json? // before/after snapshot or payload extract

  @@index([at])
  @@index([action])
  @@index([actor])
  @@index([entity, entityId])
}

/// A batch metadata file already ingested by the scheduled import service
/// (SDD: Metadata Import Service — vendor XML dropped via SFTP). Gives the
/// re-fetch job idempotency: a filename is imported once per source.
model ImportedFile {
  id                String   @id @default(cuid())
  source            String // e.g. "sftp"
  filename          String
  resourcesImported Int      @default(0)
  status            String   @default("OK") // OK, PARSE_ERROR, SKIPPED_OVERSIZE
  detail            String?
  remoteMtime       BigInt? // SFTP modifyTime (ms) — re-import when a same-name file changes
  remoteSize        BigInt? // SFTP file size (bytes) seen when last processed
  fetchedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([source, filename])
}
