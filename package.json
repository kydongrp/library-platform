    "test:tz": "tsx scripts/test-tz.ts",
    "test:calendar": "tsx scripts/test-calendar-tz.ts",
    "test:tz:guard": "tsx scripts/test-tz-guard.ts",
    "test:style": "tsx scripts/test-style.ts",
    "test:build": "tsx scripts/test-build-sync.ts",
    "test:mail": "tsx scripts/test-mail.ts",
    "test:proxy": "tsx scripts/test-proxy.ts",
    "test:linkstate": "tsx scripts/test-link-state.ts",
    "test:feed": "tsx scripts/test-feed.ts",
    "test:ssrf": "tsx scripts/test-ssrf.ts",
    "test:fetch:live": "tsx scripts/test-page-fetch-live.ts",
    "test:paging": "tsx scripts/test-paging.ts",
    "test:flexi:nl": "tsx scripts/test-flexi-nl.ts",
    "test:holds": "tsx scripts/test-hold-queue.ts",
    "test:member": "tsx scripts/test-member-status.ts",
    "test:marc:bin": "tsx scripts/test-marc-binary.ts",
    "test:marc:source": "tsx scripts/test-marc-source.ts",
    "test:marc:import": "tsx --env-file=.env.test scripts/test-marc-import-db.ts",
    "test:mail:db": "tsx --env-file=.env.development.local scripts/test-mail.ts",
    "db:harden": "tsx --env-file=.env scripts/db-harden.ts",
    "db:harden:test": "tsx --env-file=.env.test scripts/db-harden.ts",
    "test:covers": "tsx scripts/test-covers.ts",
    "test:covers:db": "tsx --env-file=.env.test scripts/test-covers-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fast-xml-parser": "^5.10.1",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ssh2-sftp-client": "^12.1.1"
