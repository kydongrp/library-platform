    "test:compare": "tsx --env-file=.env scripts/test-db-compare.ts",
    "test:compare:dev": "tsx --env-file=.env.development.local scripts/test-db-compare.ts",
    "neon:move": "tsx --env-file=.env scripts/neon-move.ts",
