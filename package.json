    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2-sftp-client": "^9.0.6",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "js-yaml": "^4.3.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=24"
  }
}
